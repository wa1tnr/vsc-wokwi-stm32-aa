
.PHONY:	all
all:	run

clean:
	@rm -rf ./.pio

distclean:	clean

# build:	showfckn

build:
	@pio run 2>&1 | cat | ag -v "LOAD segment with RWX"

built_already:
	@if [ -f ./.pio/build/nucleo_l031k6/firmware.bin ]; then \
		echo; echo "firmware.bin already built"; \
	else \
		echo; echo "firmware.bin needs to be built"; echo; \
		make clean; make build; \
	fi

.PHONY:	run
run:	built_already

# find all tabs and remove them in the status, to help form .gitignore entries
git_status:
	@git status | cat | tr -d '\t'

pwd:
	@echo -n '  ..'
	@pwd | cut -b 27-

showfckn:
	@cat ./scripts-tnr.d/showFancyChicken.txt

# end.
